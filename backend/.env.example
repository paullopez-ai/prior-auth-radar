# Data source: 'mock' uses bundled synthetic fixtures, 'sandbox' calls Optum.
APP_ENV=mock

# PostgreSQL / pgvector connection (Docker Compose service name is 'postgres').
DATABASE_URL=postgresql://pa_user:pa_password@localhost:5432/pa_agent

# AWS credentials for Bedrock (local dev). In ECS, omit these and use the IAM
# task role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Amazon Bedrock model IDs.
BEDROCK_INFERENCE_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v1

# LangSmith observability. The six-node trace is the demo centerpiece.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=prior-auth-radar-aws

# Optum sandbox API (only used when APP_ENV=sandbox).
OPTUM_CLIENT_ID=
OPTUM_CLIENT_SECRET=
OPTUM_AUTH_URL=
OPTUM_GRAPHQL_URL=
OPTUM_PROVIDER_TAX_ID=
