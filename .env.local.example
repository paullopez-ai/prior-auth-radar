# Application Mode
# 'mock' — no API calls, no login required. Default for development.
# 'sandbox' — real Optum sandbox API, login required
NEXT_PUBLIC_APP_ENV=mock

# Authentication (only needed for sandbox mode)
# Run: node scripts/generate-password-hash.mjs to generate a new password hash
AUTH_USERNAME=
AUTH_PASSWORD_HASH=<run: node scripts/generate-password-hash.mjs>
AUTH_SECRET=<random 32+ byte hex string — run: openssl rand -hex 32>

# Backend service (Python FastAPI + LangGraph).
# Used by app/api/optum/pa-status/route.ts to proxy analysis requests.
# Docker Compose sets this to http://backend:8000; AWS sets it to the ALB DNS.
BACKEND_URL=http://localhost:8000

# Forces every Refresh (and the initial load) through the backend so LangSmith
# traces are always generated. Set to "true" in Docker Compose / AWS only.
# Leave UNSET on Vercel — Vercel serves mock mode client-side as the product demo.
# NEXT_PUBLIC_FORCE_BACKEND=true

# Optum API — Sandbox Credentials (now consumed by the backend's fetch_node,
# not the frontend. Configure these in backend/.env instead. Left here for
# reference only.)
# OPTUM_CLIENT_ID=
# OPTUM_CLIENT_SECRET=
# OPTUM_AUTH_URL=https://idx.linkhealth.com/auth/realms/developer-platform/protocol/openid-connect/token
# OPTUM_GRAPHQL_URL=https://sandbox-apigw.optum.com/oihub/prior-auth/v1/graphql
# OPTUM_PROVIDER_TAX_ID=

# ANTHROPIC_API_KEY removed — Claude is no longer called from the frontend.
# All inference now runs through Amazon Bedrock in the backend service.

# Session Config (optional overrides)
SESSION_COOKIE_NAME=pa_radar_session
SESSION_EXPIRY_HOURS=24
